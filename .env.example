# Environment Mode (dev/prod)
APP_ENV=dev

# Global channel webhook (required for discord.mode = "global" or "both")
DEV_DISCORD__GLOBAL_WEBHOOK_URL=your-dev-global-webhook-url
PROD_DISCORD__GLOBAL_WEBHOOK_URL=your-prod-global-webhook-url

# Per-facility webhooks (required for discord.mode = "per_facility" or "both")
# Name: {ENV}_DISCORD__FACILITY__{FACILITY_KEY_UPPERCASE}_WEBHOOK_URL
DEV_DISCORD__FACILITY__TENIS4U_104_WEBHOOK_URL=your-dev-facility-webhook-url
PROD_DISCORD__FACILITY__TENIS4U_104_WEBHOOK_URL=your-prod-facility-webhook-url
DEV_DISCORD__FACILITY__BLONIA_BADMINTON_WEBHOOK_URL=your-dev-facility-webhook-url
PROD_DISCORD__FACILITY__BLONIA_BADMINTON_WEBHOOK_URL=your-prod-facility-webhook-url
